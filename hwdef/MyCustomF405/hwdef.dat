# MyCustomF405 hwdef for ArduPilot (ChibiOS)

MCU STM32F4xx STM32F405xx
APJ_BOARD_ID 999

# Flash / bootloader
STORAGE_FLASH_PAGE 1
IMAGE_SIZE 1024K
FLASH_SIZE_KB 1024
FLASH_BOOTLOADER_LOAD_KB 48
FLASH_RESERVE_START_KB 48
define HAL_STORAGE_SIZE 15360

# Clock / PLL (Black Pill 8MHz external crystal)
define HAL_EXPECTED_CYCLES 168000000
OSCILLATOR_HZ 8000000
define STM32_PLLM_VALUE 8
define STM32_PLLN_VALUE 336
define STM32_PLLP_VALUE 2
define STM32_PLLQ_VALUE 7
define HAL_USE_ADC TRUE
define STM32_ADC_USE_ADC1 TRUE

# USB D+ / D- (OTG FS)
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 USART6

define HAL_RCINPUT_WITH_AP_RADIO 0

# -------------------------
# PWM / Motors / Servos
PB0  TIM3_CH3  TIM3  PWM(1)  GPIO(50)
PB1  TIM3_CH4  TIM3  PWM(2)  GPIO(51)
PA6  TIM3_CH1  TIM3  PWM(3)  GPIO(52)
PA7  TIM3_CH2  TIM3  PWM(4)  GPIO(53)

PB6  TIM4_CH1  TIM4  PWM(5)  GPIO(54)  # Servo 1
PB7  TIM4_CH2  TIM4  PWM(6)  GPIO(55)  # Servo 2
PB14 TIM12_CH1 TIM12 PWM(7) GPIO(56) NODMA  # Servo 3
PB15 TIM12_CH2 TIM12 PWM(8) GPIO(57) NODMA  # Servo 4

# -------------------------
# UARTs
# UART1: Wi-Fi Link 2
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# UART2: Receiver (RC)
PA2  USART2_TX USART2
PA3  USART2_RX USART2

# UART3: GPS
PB10 USART3_TX USART3
PB11 USART3_RX USART3

# UART4: SBC
PA0  UART4_TX UART4
PA1  UART4_RX UART4

# UART6: Telemetry
PC6  USART6_TX USART6
PC7  USART6_RX USART6

# -------------------------
# I2C (sensors / compass)
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1
I2C_ORDER I2C1

# -------------------------
# SPI1 for GY-91 IMU and barometer
PB3  SPI1_SCK  SPI1
PB4  SPI1_MISO SPI1
PB5  SPI1_MOSI SPI1

# Chip-select lines
PC0  IMU_CS    CS
PC5  BMP_CS    CS

# -------------------------
# SPI device declarations: 
SPIDEV mpu9250 SPI1 DEVID1 IMU_CS MODE3 1*MHZ 8*MHZ
IMU Invensense SPI:mpu9250 ROTATION_NONE
COMPASS AK8963:probe_mpu9250 0 ROTATION_NONE

SPIDEV bmp280 SPI1 DEVID2 BMP_CS MODE3 1*MHZ 8*MHZ
BARO BMP280 SPI:bmp280

# -------------------------
# LED and Buzzer (GPIO style)
PB2 LED OUTPUT LOW GPIO(58)
define HAL_LED_ON 0

PA8 TIM1_CH1 TIM1 PWM(9) GPIO(59)
define HAL_BUZZER_PIN 59
define AP_NOTIFY_BUZZER_ENABLED 1

# -------------------------
# microSD (SDIO) pins
PC8  SDIO_D0   SDIO SPEED_HIGH PULLUP
PC9  SDIO_D1   SDIO SPEED_HIGH PULLUP
PC10 SDIO_D2   SDIO SPEED_HIGH PULLUP
PC11 SDIO_D3   SDIO SPEED_HIGH PULLUP
PC12 SDIO_CK   SDIO SPEED_HIGH
PD2  SDIO_CMD  SDIO SPEED_HIGH PULLUP

# SDIO uses a dedicated DMA stream on STM32F405
DMA_PRIORITY SDIO

# User key and analog inputs
PC13 USER_KEY INPUT PULLUP GPIO(60)
PC1  BATT_CURRENT_SENS ADC1
PC2  BATT_VOLTAGE_SENS ADC1
PC3  ADC3 ADC1

# FAT/SD settings
define FATFS_HAL_DEVICE SDCD1
define HAL_WITH_SDCARD 1
