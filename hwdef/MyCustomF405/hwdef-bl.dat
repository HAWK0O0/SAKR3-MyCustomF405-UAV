# Bootloader hwdef
MCU STM32F4xx STM32F405xx
APJ_BOARD_ID 999
OSCILLATOR_HZ 8000000
define STM32_ST_USE_TIMER 5

FLASH_SIZE_KB 1024
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 48

SERIAL_ORDER OTG1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# Keep sensor chip-select lines inactive while in the bootloader
PC0 IMU_CS CS
PC5 BMP_CS CS
